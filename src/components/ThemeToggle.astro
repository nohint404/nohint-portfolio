<div class="theme-picker" data-theme-picker>
  <button class="theme-trigger" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Choose color theme">
    <span class="theme-icon" aria-hidden="true">
      <svg data-theme-icon="system" viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="12" rx="2"/><path d="M8 20h8M12 16.5V20"/></svg>
      <svg data-theme-icon="light" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/></svg>
      <svg data-theme-icon="dark" viewBox="0 0 24 24"><path d="M20 15.2A8.4 8.4 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"/></svg>
    </span>
    <span class="theme-label" data-theme-label>System</span>
  </button>
  <div class="theme-menu" role="menu" aria-label="Color theme" hidden>
    <button type="button" role="menuitemradio" aria-checked="true" data-theme-choice="system"><span class="choice-icon" aria-hidden="true">◫</span><span>System</span><span class="choice-check">✓</span></button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="light"><span class="choice-icon" aria-hidden="true">☼</span><span>Light</span><span class="choice-check">✓</span></button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="dark"><span class="choice-icon" aria-hidden="true">◐</span><span>Dark</span><span class="choice-check">✓</span></button>
  </div>
</div>
<script>
  const STORAGE_KEY = 'nohint-theme';
  const picker = document.querySelector<HTMLElement>('[data-theme-picker]');
  if (picker && !picker.dataset.ready) {
    picker.dataset.ready = 'true';
    const trigger = picker.querySelector<HTMLButtonElement>('.theme-trigger')!;
    const menu = picker.querySelector<HTMLElement>('.theme-menu')!;
    const label = picker.querySelector<HTMLElement>('[data-theme-label]')!;
    const choices = [...picker.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const readPreference = () => {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        return saved === 'light' || saved === 'dark' ? saved : 'system';
      } catch { return 'system'; }
    };
    const apply = (preference: 'system' | 'light' | 'dark', persist = false) => {
      const resolved = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
      const root = document.documentElement;
      root.dataset.themePreference = preference;
      root.dataset.theme = resolved;
      root.style.colorScheme = resolved;
      label.textContent = preference[0]!.toUpperCase() + preference.slice(1);
      picker.querySelectorAll<SVGElement>('[data-theme-icon]').forEach(icon => icon.toggleAttribute('hidden', icon.dataset.themeIcon !== preference));
      choices.forEach(button => button.setAttribute('aria-checked', String(button.dataset.themeChoice === preference)));
      document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', resolved === 'dark' ? '#0B1826' : '#F6FBFF');
      if (persist) try { localStorage.setItem(STORAGE_KEY, preference); } catch {}
    };
    const close = () => { menu.hidden = true; trigger.setAttribute('aria-expanded', 'false'); };
    trigger.addEventListener('click', () => {
      const opening = menu.hidden;
      menu.hidden = !opening;
      trigger.setAttribute('aria-expanded', String(opening));
      if (opening) choices.find(button => button.getAttribute('aria-checked') === 'true')?.focus();
    });
    choices.forEach(button => button.addEventListener('click', () => {
      apply(button.dataset.themeChoice as 'system' | 'light' | 'dark', true);
      close();
      trigger.focus();
    }));
    picker.addEventListener('keydown', event => { if (event.key === 'Escape') { close(); trigger.focus(); } });
    document.addEventListener('pointerdown', event => { if (!picker.contains(event.target as Node)) close(); });
    media.addEventListener('change', () => { if (readPreference() === 'system') apply('system'); });
    apply(readPreference());
  }
</script>
<style>
  .theme-picker{position:relative}.theme-trigger{height:42px;display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--surface);color:var(--text);border-radius:999px;padding:0 12px;cursor:pointer}.theme-icon{display:grid;place-items:center;width:18px;height:18px}.theme-icon svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.theme-icon svg[hidden]{display:none}.theme-label{font-size:12px;font-weight:650}.theme-menu{position:absolute;right:0;top:calc(100% + 8px);z-index:60;width:150px;padding:6px;background:var(--paper);border:1px solid var(--line);border-radius:14px;box-shadow:0 16px 40px color-mix(in srgb,var(--text) 14%,transparent)}.theme-menu[hidden]{display:none}.theme-menu button{width:100%;min-height:40px;border:0;border-radius:9px;background:transparent;color:var(--text);display:grid;grid-template-columns:20px 1fr 16px;align-items:center;gap:8px;padding:8px 9px;text-align:left;cursor:pointer}.theme-menu button:hover,.theme-menu button:focus-visible{background:var(--surface)}.choice-icon{font-size:15px;text-align:center}.choice-check{opacity:0;text-align:right;color:var(--accent-strong);font-weight:800}.theme-menu button[aria-checked='true'] .choice-check{opacity:1}@media (max-width:720px){.theme-label{display:none}.theme-trigger{width:42px;padding:0;justify-content:center}}
</style>

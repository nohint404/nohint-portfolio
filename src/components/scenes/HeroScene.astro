---
import Workspace from '../Workspace.svelte';
import DrawnLine from '../motion/DrawnLine.astro';
---
<section class="hero-scene shell" aria-labelledby="hero-title">
  <div class="identity-stage"><p class="whoami"><code>$ whoami</code><span class="signal-dot" aria-hidden="true"></span></p><h1 id="hero-title">nohint404</h1><DrawnLine /></div>
  <div class="hero-workbench"><div class="hero-copy"><h2>Developer tools.<br />Web interfaces.<br />A little mischief.</h2><p>I build things I can take apart.<br />Mostly from a Linux terminal.</p><div class="hero-links"><a class="primary-link" href="#work">Open the work <span aria-hidden="true">↗</span></a><a href="#contact">Say hello</a></div></div><Workspace client:load /></div>
</section>
<script>
  const media = matchMedia('(prefers-reduced-motion: reduce)');
  const animations: Animation[] = [];
  const cancel = () => animations.forEach(animation => animation.cancel());
  if (!media.matches) {
    document.querySelectorAll('.identity-stage h1, .workspace-sheets').forEach((node, i) => animations.push(node.animate(i ? [{transform:'translateY(12px) rotate(-3deg)',clipPath:'inset(46% 0 46% 0 round 14px)',offset:0},{transform:'translateY(8px) rotate(-2deg)',clipPath:'inset(42% 0 42% 0 round 14px)',offset:.15},{transform:'none',clipPath:'inset(-30% -20% -30% -20% round 14px)',offset:1}] : [{transform:'scaleX(.94)',fontWeight:550},{transform:'none',fontWeight:750}],{duration:i ? 900 : 650,easing:'cubic-bezier(.16,1,.3,1)'})));
  }
  media.addEventListener('change', cancel);
  addEventListener('pagehide', () => { cancel(); media.removeEventListener('change', cancel); }, {once:true});
</script>

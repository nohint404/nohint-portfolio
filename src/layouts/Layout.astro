---
import font from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/palette-refresh.css';
import '../styles/psystream-featured.css';
import GlobalNav from '../components/GlobalNav.astro';
import { profile } from '../data/profile';
import Analytics from '@vercel/analytics/astro';
interface Props { title?: string; description?: string; image?: string }
const { title = 'nohint404 — Developer tooling & web interfaces', description = profile.description, image = '/share.png' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content="#F6FBFF" /><meta name="color-scheme" content="light dark" />
  <script is:inline>
    (() => {
      const key = 'nohint-theme';
      let preference = 'system';
      try {
        const saved = localStorage.getItem(key);
        if (saved === 'light' || saved === 'dark') preference = saved;
      } catch {}
      const resolved = preference === 'system'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : preference;
      const root = document.documentElement;
      root.dataset.themePreference = preference;
      root.dataset.theme = resolved;
      root.style.colorScheme = resolved;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', resolved === 'dark' ? '#091825' : '#F6FBFF');
    })();
  </script>
  <style>@font-face{font-family:"Bricolage Grotesque Variable";font-style:normal;font-weight:200 800;font-display:swap;src:url(@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2) format("woff2");}</style>
  <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
  <meta property="og:site_name" content="nohint404" /><meta name="twitter:card" content="summary_large_image" />
  {Astro.site && <><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(image, Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={title} /></>}
  <Analytics />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<GlobalNav />
<main id="main"><slot /></main>
<footer class="shell footer"><a class="identity" href="/">nohint404</a><p>Built to be taken apart. Astro, Svelte & Bun.</p><a href={profile.github}>GitHub</a></footer>

</body>
</html>

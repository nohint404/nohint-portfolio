---
import Layout from '../../layouts/Layout.astro';
import InteractiveArchitecture from '../../components/InteractiveArchitecture.svelte';
import ArchitectureGraph from '../../components/ArchitectureGraph.svelte';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
const index = projects.findIndex(item => item.slug === project.slug);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const id = (text: string) => text.toLowerCase().replace(/[^a-z0-9 ]/g,'').replaceAll(' ','-');
---
<Layout title={`${project.name} — nohint404`} description={project.summary} image="/share.png">
  <div class="shell case-study"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">~</a><span>/</span><a href="/#work">work</a><span>/</span><span aria-current="page">{project.slug}</span></nav><header class="case-header"><p class="quiet">{project.kind} · {project.role} / {project.repositoryOwner}</p><h1>{project.name}</h1><p class="case-summary">{project.summary}</p><ul class="tags" aria-label="Technologies">{project.technologies.map(technology => <li>{technology}</li>)}</ul><a class="text-link" href={project.repository}>View repository <span aria-hidden="true">↗</span></a></header>
  {project.slug === 'vs-notrack' && <InteractiveArchitecture client:visible />}
  {project.slug === 'monolith' && project.architecture && <ArchitectureGraph project={project} client:visible />}
  <div class="case-sections">{project.contributions && <section><h2>My contribution record.</h2><div>{project.contributions.map(item => <details><summary>{item.title}</summary><p>{item.text}</p><a href={item.source}>Read the commit</a></details>)}</div></section>}{project.sections.map(section => <section id={id(section.title)}><h2>{section.title}</h2><div><p>{section.text}</p><a class="source-link" href={section.source}>{section.label} <span aria-hidden="true">↗</span></a></div></section>)}</div>
  <nav class="case-pager" aria-label="More projects"><a class="text-link" href={`/work/${previous.slug}/`}>← {previous.name}</a><a class="text-link" href={`/work/${next.slug}/`}>{next.name} →</a></nav>
  <div class="case-end"><a class="text-link" href="/#work">Back to selected work</a><a class="text-link" href="/#contact">Get in touch</a></div></div>
</Layout>
